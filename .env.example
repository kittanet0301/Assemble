# Local demo is available only on loopback, explicitly enabled by the dev command.
PORT=4173
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:4173
OFFICE_NAME=Assemble HQ
ORG_NAME=Assemble
ALLOWED_DOMAINS=your-company.com
ADMIN_EMAILS=admin@your-company.com
# REQUIRED for production. Generate a random value of at least 32 characters.
SESSION_SECRET=
AUTH_MODE=oidc
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# OAuth callbacks: PUBLIC_ORIGIN/auth/google/callback and /auth/microsoft/callback
# Set all three values to enable real meeting audio/video/screen sharing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional protected team preview: pnpm preview:tunnel https://your-domain.ngrok-free.dev
# The launcher generates and prints a temporary password if this is empty.
PREVIEW_ORIGIN=
PREVIEW_PASSWORD=
# Preview always uses a separate database. Never point this at office.sqlite.
PREVIEW_DATA_FILE=data/tunnel-preview.sqlite
MAX_MEMBERS=50
MAX_ONLINE=20
ROOM_CAPACITY=8
CHAT_RETENTION_DAYS=30
