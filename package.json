{
  "name": "assemble-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=shared server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "preview:tunnel": "node scripts/start-tunnel-preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:production": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.14",
    "@livekit/components-styles": "^1.1.6",
    "express": "^5.1.0",
    "livekit-client": "^2.15.6",
    "livekit-server-sdk": "^2.14.0",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
